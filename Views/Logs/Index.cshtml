@model LogFilterViewModel
@{ViewData["Title"]="Log Explorer";}
<section class="panel"><form method="get" class="filter-bar"><input name="Search" value="@Model.Search" placeholder="Search message..."/><select name="Severity"><option value="">All severities</option>@foreach(var s in new[]{"DEBUG","INFO","WARNING","ERROR","CRITICAL","SECURITY"}){<option selected="@(Model.Severity==s)" value="@s">@s</option>}</select><input name="Service" value="@Model.Service" placeholder="Service"/><input name="Application" value="@Model.Application" placeholder="Application"/><select name="Environment"><option value="">All environments</option><option selected="@(Model.Environment=="Production")">Production</option><option selected="@(Model.Environment=="Staging")">Staging</option><option selected="@(Model.Environment=="Development")">Development</option><option selected="@(Model.Environment=="Imported")">Imported</option><option selected="@(Model.Environment=="Demo")">Demo</option></select><input type="datetime-local" name="From" value="@(Model.From?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))"/><input type="datetime-local" name="To" value="@(Model.To?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))"/><button class="btn btn-primary">Filter</button><a class="btn btn-ghost" asp-action="Index">Reset</a></form></section>
<section class="panel"><div class="panel-head"><div><h2>@Model.Total.ToString("N0") matching logs</h2></div></div><div class="table-wrap"><table><thead><tr><th>Timestamp</th><th>Severity</th><th>Service</th><th>Message</th><th></th></tr></thead><tbody>@foreach(var x in Model.Results){<tr><td>@x.Timestamp.ToLocalTime().ToString("dd MMM HH:mm:ss")</td><td><span class="severity @x.Severity.ToLower()">@x.Severity</span></td><td>@x.Service</td><td>@x.Message</td><td><a class="text-link" asp-action="Details" asp-route-id="@x.Id">Inspect</a></td></tr>}@if(!Model.Results.Any()){<tr><td colspan="5"><div class="empty">No logs match these filters.</div></td></tr>}</tbody></table></div></section>
