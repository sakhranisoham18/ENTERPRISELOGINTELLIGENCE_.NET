@model AlertsViewModel
@{ViewData["Title"]="Alerts";}
<div class="grid-2"><section class="panel"><div class="panel-head"><div><h2>New alert</h2></div></div>@if(User.IsInRole("Administrator")){<form method="post" asp-action="Create" class="form-stack"><input name="Name" placeholder="Alert name" required/><select name="Severity"><option>ERROR</option><option>CRITICAL</option><option>WARNING</option><option>SECURITY</option></select><label>Threshold<input type="number" name="Threshold" value="10" min="1"/></label><label>Window (minutes)<input type="number" name="WindowMinutes" value="5" min="1" max="1440"/></label><label>Cooldown (minutes)<input type="number" name="CooldownMinutes" value="15" min="1" max="1440"/></label><button class="btn btn-primary">Create alert</button></form>}else{<p class="muted">Only administrators can create or change alert rules.</p>}</section><section class="panel"><div class="panel-head"><div><h2>Alert rules</h2></div></div>@if(!Model.Rules.Any()){<div class="empty">No alerts configured yet.</div>}@foreach(var a in Model.Rules){<div class="alert-row"><div><strong>@a.Name</strong><small>@a.Severity above @a.Threshold events in @a.WindowMinutes min, cooldown @a.CooldownMinutes min</small></div><div style="display:flex;gap:8px;align-items:center"><span class="status-badge">@(a.IsEnabled?"Active":"Disabled")</span>@if(User.IsInRole("Administrator")){<form method="post" asp-action="Toggle" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id"/><button class="btn btn-ghost" type="submit">@(a.IsEnabled?"Disable":"Enable")</button></form><form method="post" asp-action="Delete" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id"/><button class="btn btn-ghost" type="submit">Delete</button></form>}</div></div>}</section></div>
<section class="panel"><div class="panel-head"><div><h2>Recent alert events</h2></div></div><div class="table-wrap"><table><thead><tr><th>Triggered</th><th>Rule</th><th>Severity</th><th>Occurrences</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model.Events){<tr><td>@e.TriggeredAt.ToLocalTime().ToString("dd MMM HH:mm:ss")</td><td>@e.RuleName</td><td><span class="severity @e.Severity.ToLower()">@e.Severity</span></td><td>@e.Occurrences</td><td>@e.Status</td></tr>}@if(!Model.Events.Any()){<tr><td colspan="5"><div class="empty">No alert events have triggered yet.</div></td></tr>}</tbody></table></div></section>
