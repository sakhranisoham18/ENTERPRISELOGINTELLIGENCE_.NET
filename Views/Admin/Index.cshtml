@model AdminViewModel
@{ViewData["Title"]="Administration";}
<div class="kpi-grid"><div class="kpi"><span>Storage</span><strong style="font-size:24px">@Model.StorageProvider</strong><small>@Model.DatabaseName</small></div><div class="kpi"><span>MongoDB</span><strong style="font-size:24px">@(Model.MongoConnected?"Connected":"Not connected")</strong><small>Phase 2 database status</small></div><div class="kpi"><span>Ingestion API</span><strong style="font-size:24px">@(Model.IngestionApiKeyConfigured?"Protected":"Open")</strong><small>X-ELI-API-Key</small></div><div class="kpi"><span>Users</span><strong>@Model.Users.Count</strong><small>Application identities</small></div></div>
<div class="grid-2"><section class="panel"><div class="panel-head"><div><h2>Create user</h2></div></div><form method="post" asp-action="CreateUser" class="form-stack"><input name="username" placeholder="Username" required/><input name="password" type="password" placeholder="Temporary password" required minlength="8"/><select name="role"><option>Analyst</option><option>Administrator</option></select><button class="btn btn-primary">Create user</button></form><div class="table-wrap" style="margin-top:20px"><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last login</th><th></th></tr></thead><tbody>@foreach(var u in Model.Users){<tr><td>@u.Username</td><td>@u.Role</td><td>@(u.IsActive?"Active":"Disabled")</td><td>@(u.LastLoginAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "Never")</td><td><form method="post" asp-action="ToggleUser">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><button class="btn btn-ghost" type="submit">@(u.IsActive?"Disable":"Enable")</button></form></td></tr>}</tbody></table></div></section>
<section class="panel"><div class="panel-head"><div><h2>Recent activity</h2></div></div><div class="table-wrap"><table><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach(var a in Model.AuditLogs){<tr><td>@a.Timestamp.ToLocalTime().ToString("dd MMM HH:mm:ss")</td><td>@a.Username</td><td>@a.Action</td><td>@a.Details</td></tr>}@if(!Model.AuditLogs.Any()){<tr><td colspan="4"><div class="empty">No audit events yet.</div></td></tr>}</tbody></table></div></section></div>
<section class="panel"><div class="panel-head"><div><h2>Connect MongoDB Atlas</h2></div></div><p class="muted">Set <code>Storage:Provider</code> to <code>MongoDB</code> and supply <code>MongoDb:ConnectionString</code>. For a local development secret, prefer the ASP.NET Core Secret Manager or environment variables rather than committing credentials.</p><pre class="code-block">Storage__Provider=MongoDB
MongoDb__ConnectionString=mongodb+srv://&lt;user&gt;:&lt;password&gt;@@&lt;cluster&gt;.mongodb.net/?retryWrites=true&amp;w=majority
MongoDb__DatabaseName=EnterpriseLogIntelligence
Authentication__SeedAdminPassword=&lt;strong-admin-password&gt;
Ingestion__ApiKey=&lt;strong-api-key&gt;</pre></section>
