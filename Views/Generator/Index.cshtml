@{ViewData["Title"]="Log Generator";}
<section class="panel generator"><div class="generator-copy"><h2>Generate realistic activity</h2><p>Use the simulator to create a controlled volume of enterprise-style logs for dashboards, filtering and pattern detection.</p></div><form method="post" asp-action="Generate" class="generator-form"><label>Events to generate<input type="number" name="count" value="250" min="1" max="2000"/></label><div class="preset-row"><button type="button" data-value="100">100</button><button type="button" data-value="250">250</button><button type="button" data-value="500">500</button><button type="button" data-value="1000">1,000</button></div><button class="btn btn-primary btn-lg">Generate and ingest</button></form>@if(TempData["Message"]!=null){<div class="success">@TempData["Message"]</div>}</section>
